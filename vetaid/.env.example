# ══════════════════════════════════════════════════════
# VetAid — Environment Variables Template
# ══════════════════════════════════════════════════════
# 1. Copy this file and rename it to: .env
# 2. Replace "your_groq_api_key_here" with your actual key
# 3. Get your free Groq API key at: https://console.groq.com
# ══════════════════════════════════════════════════════

GROQ_API_KEY=your_groq_api_key_here

# Endee vector database (see README: "Connect an Endee database")
# Route A - serverless (app.endee.io, free Starter plan):
ENDEE_TOKEN=your_serverless_auth_token_here
# Route B - self-hosted instead:
# ENDEE_ROOT_TOKEN=your_endee_root_token_here
# ENDEE_BASE_URL=http://localhost:8080/api/v2
# ENDEE_DB_NAME=vetaid
